# Python version pinning
.python-version

# Python bytecode / caches
__pycache__/
*.py[oc]
*.pyo
.pyc

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST
.eggs/
sdist/
develop-eggs/
lib/
lib64/
parts/
var/

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Environment / secrets
.env
.env.*
!.env.example

# uv
.uv/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Testing
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml

# Linting / formatting
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Eval output (generated at runtime — never commit any of it, but keep the dir)
# NOTE: `template/*/` matches the component folder (template/[[ evaluation_app_name ]]/).
# A literal `[` would be parsed as a gitignore character class, so glob with `*` instead.
template/*/output/*
!template/*/output/.gitkeep

# Claude-generated test cases (review before committing)
template/*/user_datasets/generated_cases.json

# Local copier render output (`task render` — inspect-only, never commit)
.rendered/
